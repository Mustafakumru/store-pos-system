<Window x:Class="LCWaikiki.POS.WpfClient.Views.MainPosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:http="clr-namespace:LCWaikiki.POS.WpfClient.Core.Http"
        xmlns:offline="clr-namespace:LCWaikiki.POS.WpfClient.Core.Offline"
        xmlns:views="clr-namespace:LCWaikiki.POS.WpfClient.Views"
        xmlns:converters="clr-namespace:LCWaikiki.POS.WpfClient.Converters"
        Title="WPOS - Fis Ekrani"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F2F5">

    <Window.Resources>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightPanelBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Odeme yontemi butonlari (sag kolon) -->
        <!-- Islemler paneli: outlined buton (Background/BorderBrush/Foreground her buton icin ayri ayarlanir) -->
        <Style x:Key="OutlineMenuBtn" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#007BFF"/>
            <Setter Property="Foreground" Value="#007BFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#11000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PayMethodBtn" TargetType="Button" BasedOn="{StaticResource RightPanelBtn}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Ust bar sekme butonu: aktifken alt cizgi mavi + kalin, pasifken gri -->
        <Style x:Key="TopTabBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fiyat/etiket kapsulu (kucuk pill) -->
        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
        </Style>

        <!-- Sepet satiri: secili (ListBoxItem) mavi, iptal siyah/uzeri cizili, iade turuncu -->
        <Style x:Key="CartRowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBd" Background="White" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="#007BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#007BFF" CornerRadius="14"
                        Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="W" FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="1" Content="{Binding DocumentModeLabel}"
                        Command="{Binding GoToProductsTabCommand}"
                        Foreground="#007BFF" Background="Transparent"
                        BorderThickness="0,0,0,2" BorderBrush="#007BFF"
                        FontSize="13" FontWeight="Bold"
                        Padding="10,0" Height="48" Focusable="False" Cursor="Hand"/>
                <Button Grid.Column="2" Content="Urun Ekle/Cikar"
                        Foreground="#616161" Background="Transparent"
                        BorderThickness="0" FontSize="12"
                        Padding="10,0" Height="48" Focusable="False" Cursor="Hand"
                        Command="{Binding GoToProductsTabCommand}"/>
                <Button Grid.Column="3" Content="Kampanya/Indirim"
                        Foreground="#616161" Background="Transparent"
                        BorderThickness="0" FontSize="12"
                        Padding="10,0" Height="48" Focusable="False" Cursor="Hand"
                        Command="{Binding GoToDiscountTabCommand}"/>
                <Button Grid.Column="4" Content="Iade &amp; Degisim"
                        Foreground="#616161" Background="Transparent"
                        BorderThickness="0" FontSize="12"
                        Padding="10,0" Height="48" Focusable="False" Cursor="Hand"
                        Command="{Binding OpenExchangeCommand}"/>
                <Button Grid.Column="5" Content="Odeme"
                        Foreground="#616161" Background="Transparent"
                        BorderThickness="0" FontSize="12"
                        Padding="10,0" Height="48" Focusable="False" Cursor="Hand"
                        Command="{Binding GoToPaymentCommand}"/>

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF3CD" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CashierName}" FontSize="11" FontWeight="SemiBold" Foreground="#856404"/>
                    </Border>
                    <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold"
                               Foreground="#616161" FontFamily="Consolas" Margin="0,0,8,0"/>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#28A745"/>
                            <Setter Property="ToolTip" Value="Sunucu baglantisi var"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline, Source={x:Static http:ConnectivityMonitor.Instance}}" Value="False">
                                    <Setter Property="Fill" Value="#DC3545"/>
                                    <Setter Property="ToolTip" Value="Sunucuya ulasilamiyor"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                    <TextBlock Text="{Binding StatusText, Source={x:Static offline:OfflineSaleQueue.Current}}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#E65100" Margin="8,0,0,0" VerticalAlignment="Center"
                               ToolTip="Sunucuya gonderilmemis cevrimdisi satislar (Ana Menu > Cevrimdisi Satislar)"
                               Visibility="{Binding HasPending, Source={x:Static offline:OfflineSaleQueue.Current}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ANA ICERIK ALANI: Sol (Sepet, 6*) / Ayirici / Sag (Numpad, 4*) ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ SOL PANEL: Sepet ══════════ -->
            <Grid Grid.Column="0" Background="#F8F9FA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding CartItems}"
                         SelectedItem="{Binding SelectedCartItem}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0"
                         ItemContainerStyle="{StaticResource CartRowContainer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReturnItem}" Value="True">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sutun 0: Barkod/Ad/Renk-Beden-Adet/Fiyat - hepsi burada -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="10" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Barcode}"/>
                                                    <Setter Property="Foreground" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected,
                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Urun adi + Fiyat ayni satirda (ad sola, fiyat saga) -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ProductName}"/>
                                                        <Setter Property="Foreground" Value="#212121"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected,
                                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="#BDBDBD"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="{Binding LineTotal, Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                                        <Setter Property="Foreground" Value="#212121"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected,
                                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsReturnItem}" Value="True">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="#BDBDBD"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#757575"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected,
                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#E3F2FD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Color}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Size}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Quantity}"/>
                                            <Run Text=" AD"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,0"
                                                   Visibility="{Binding IsReturnItem, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="IADE"/>
                                            <Run Text="{Binding SourceReceiptNumber, Mode=OneWay, StringFormat=' - Fis: {0}', TargetNullValue=' - Fissiz'}"/>
                                            <Run Text="{Binding ReturnReasonName, Mode=OneWay, StringFormat=' | {0}'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Sutun 1: Urun Gorseli -->
                                    <Border Grid.Column="1" Width="60" Height="80"
                                            Background="#F0F0F0" CornerRadius="4"
                                            Margin="10,0,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding FullImageUrl, TargetNullValue={x:Null}}"
                                                   Visibility="{Binding FullImageUrl,
                                                       Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="&#x1F455;" FontSize="24" Foreground="#BDBDBD"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FullImageUrl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Alt: Parca Adet + Toplam ustte, Taksit kutusu hemen altinda SOLA YASLI -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding LineCount, Mode=OneWay, StringFormat='Parca Adet: {0}'}"
                                       FontSize="13" Foreground="#616161" VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding FinalAmount, Mode=OneWay, Converter={StaticResource DecimalToCurrencyConverter}}"
                                       FontSize="34" FontWeight="Bold" Foreground="#212121"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Taksit Kutusu: tek Border, icerik kadar genislik (Stretch YOK), sola yasli -->
                        <Border HorizontalAlignment="Left" BorderBrush="LightGray" BorderThickness="1"
                                CornerRadius="4" ClipToBounds="True">
                            <StackPanel>
                                <!-- 8 Taksit -->
                                <Button Focusable="False" Cursor="Hand"
                                        BorderThickness="0" Padding="12,7"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ToggleInstallment8Command}">
                                    <Button.Content>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White">
                                            <Run Text="8 Taksitli Fiyat = "/>
                                            <Run Text="{Binding Installment8, Mode=OneWay,
                                                Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                        </TextBlock>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background" Value="#108910"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInstallment, Mode=OneWay}" Value="8">
                                                    <Setter Property="Background" Value="#0B650B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Ince, hafif saydam beyaz ayirici cizgi -->
                                <Border Height="1" Background="#40FFFFFF"/>

                                <!-- 4 Taksit -->
                                <Button Focusable="False" Cursor="Hand"
                                        BorderThickness="0" Padding="12,7"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ToggleInstallment4Command}">
                                    <Button.Content>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White">
                                            <Run Text="4 Taksitli Fiyat = "/>
                                            <Run Text="{Binding Installment4, Mode=OneWay,
                                                Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                        </TextBlock>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background" Value="#108910"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInstallment, Mode=OneWay}" Value="4">
                                                    <Setter Property="Background" Value="#0B650B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dikey Ayirici -->
            <Border Grid.Column="1" Background="#EAEAEA"/>

            <!-- ══════════ SAG PANEL: Urun Bilgisi + Indirim + Barkod + Numpad ══════════ -->
            <Grid Grid.Column="2" Background="#FAFAFA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══ Tasiyici Izgara: Urun Karti (Sutun 0, *) + Hizli Urunler (Sutun 1, Auto) ══ -->
                <Grid Grid.Row="0" Margin="16,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol Sutun: Secili Urun ve Indirim Karti -->
                    <Border Grid.Column="0" Background="#FFFFFF"
                            BorderBrush="#EAEAEA" BorderThickness="1" Padding="10"
                            MinHeight="140">
                        <StackPanel Visibility="Visible">
                            <TextBlock Text="{Binding SelectedCartItem.ProductName}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       Foreground="#212121" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontFamily="Segoe UI" FontSize="10" Foreground="#9E9E9E"
                                       Margin="0,2,0,8" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasSelectedCartItem, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="{Binding SelectedCartItem.Color}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding SelectedCartItem.Size}"/>
                            </TextBlock>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="Tutar Indirim"
                                        Background="#FFC107" Foreground="#212121"
