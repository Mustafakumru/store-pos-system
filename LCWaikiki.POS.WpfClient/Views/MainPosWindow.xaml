                                <Button Grid.Row="3" Grid.Column="0" Content="," Tag="cust-comma" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Tag="cust-0" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="C" Tag="cust-clearall" Style="{StaticResource NumBtn}"
                                        Background="#DC3545" Foreground="White"/>
                            </Grid>
                        </StackPanel>

                        <!-- SAG: Sonuc (Bulunan Musteri / Yeni Kayit Formu) -->
                        <StackPanel Grid.Column="1" Margin="30,20,20,20">

                            <!-- Bulunan musteri detaylari -->
                            <StackPanel Visibility="{Binding HasFoundCustomer,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Musteri Numarasi" FontSize="11" Foreground="#9E9E9E"/>
                                    <TextBlock Text="{Binding FoundCustomer.Id}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#212121" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Ad &amp; Soyad" FontSize="11" Foreground="#9E9E9E"/>
                                    <TextBlock Text="{Binding FoundCustomer.FullName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#212121" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Cep Telefonu" FontSize="11" Foreground="#9E9E9E"/>
                                    <TextBlock Text="{Binding FoundCustomer.PhoneNumber}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#212121" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="SMS Izni" FontSize="11" Foreground="#9E9E9E"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Hayir"/>
                                                <Setter Property="Foreground" Value="#DC3545"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FoundCustomer.SmsConsent}" Value="True">
                                                        <Setter Property="Text" Value="Evet"/>
                                                        <Setter Property="Foreground" Value="#28A745"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Content="Musteriyi Sec" Focusable="False" Cursor="Hand"
                                        Background="#28A745" Foreground="White"
                                        FontSize="14" FontWeight="Bold" BorderThickness="0"
                                        MinHeight="50" Margin="0,30,0,0"
                                        Command="{Binding ConfirmSelectionCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Bulunamadi -> Yeni kayit formu -->
                            <StackPanel Visibility="{Binding ShowNewCustomerForm,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Musteri bulunamadi. Yeni kayit acin:"
                                           FontSize="12" Foreground="#DC3545" Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Ad Soyad" FontSize="11" Foreground="#9E9E9E" Margin="0,0,0,4"/>
                                <TextBox FontSize="14" Foreground="#212121" Background="White"
                                         BorderBrush="#66AFE9" BorderThickness="2"
                                         Padding="8,6" Margin="0,0,0,10" MinHeight="44"
                                         Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Email (opsiyonel)" FontSize="11" Foreground="#9E9E9E" Margin="0,0,0,4"/>
                                <TextBox FontSize="14" Foreground="#212121" Background="White"
                                         BorderBrush="#66AFE9" BorderThickness="2"
                                         Padding="8,6" Margin="0,0,0,10" MinHeight="44"
                                         Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="SMS izni var" Foreground="#212121" FontSize="12"
                                          IsChecked="{Binding NewSmsConsent}" Margin="0,0,0,14"/>
                                <Button Content="Musteriyi Kaydet" Focusable="False" Cursor="Hand"
                                        Background="#28A745" Foreground="White"
                                        FontSize="14" FontWeight="Bold" BorderThickness="0"
                                        Padding="0,16"
                                        Command="{Binding CreateCustomerCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11" Foreground="#DC3545"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ErrorMessage,
                                           Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- YENI MUSTERI - kayit formu, su an gorunur (test asamasi) -->
                    <Grid Grid.Row="1" x:Name="YeniMusteriGrid"
                          Visibility="{Binding ShowNewCustomerForm,
                              Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Width="450"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="Yeni Musteri Kaydi" FontSize="24" FontWeight="Bold"
                                       Foreground="#424242" Margin="0,0,0,20"/>

                            <TextBlock Text="Ad Soyad" FontSize="16" Foreground="#616161" Margin="0,0,0,5"/>
                            <TextBox FontSize="20" Foreground="#212121" Background="White"
                                     CaretBrush="#007BFF" BorderBrush="#B0C4DE"
                                     BorderThickness="1" Padding="12,0"
                                     Height="60" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,20"
                                     GotFocus="TextBox_GotFocus_OpenKeyboard"
                                     Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Cep Telefonu" FontSize="16" Foreground="#616161" Margin="0,0,0,5"/>
                            <TextBox FontSize="20" Foreground="#212121" Background="White"
                                     CaretBrush="#007BFF" BorderBrush="#B0C4DE"
                                     BorderThickness="1" Padding="12,0"
                                     Height="60" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     MaxLength="11" Margin="0,0,0,30"
                                     GotFocus="TextBox_GotFocus_OpenKeyboard"
                                     Text="{Binding PhoneInput, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Content="Kaydet ve Sec" Focusable="False" Cursor="Hand"
                                    Background="#28A745" Foreground="White"
                                    FontSize="24" FontWeight="Bold" BorderThickness="0"
                                    Width="450" Height="60"
                                    HorizontalAlignment="Center"
                                    Command="{Binding CreateCustomerCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12" Foreground="#DC3545"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding ErrorMessage,
                                           Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Alt: Secim yapmadan devam et -->
                    <Button Grid.Row="2" Content="Secim yapmadan devam et"
                            Focusable="False" Cursor="Hand"
                            Background="#17A2B8" Foreground="White"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                            Padding="20,15" Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!-- ── Islemler Paneli: yatay, aydinlik, Alt Bar'in hemen ustunde ── -->
        <Grid Grid.Row="1" Panel.ZIndex="20"
              Visibility="{Binding IsHamburgerMenuOpen,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#33000000"/>
            <Border Background="#FFFFFF" BorderBrush="#EAEAEA" BorderThickness="0,1,0,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <StackPanel Margin="16,10,16,14">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Islemler" FontSize="14" Foreground="#6C757D"/>
                        <Button Content="&#x2715;" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#9E9E9E"
                                BorderThickness="0" FontSize="14"
                                Focusable="False" Cursor="Hand"
                                Command="{Binding CloseHamburgerMenuCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="4,0">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="#EAEAEA" Margin="0,0,0,12"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding ContinueWithInvoiceCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F9FE;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fatura ile" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Devam Et" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding ChangeDocumentTypeCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4CB;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Belge Tipini" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Degistir" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding OpenGiftCardSaleCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F381;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hediye Karti" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Ekle" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Istisna: dolu mavi -->
                        <Button Width="90" Height="80" Margin="5" Focusable="False" Cursor="Hand"
                                Background="#007BFF" BorderThickness="0" Foreground="White"
                                Command="{Binding OpenGiftCardSaleCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4B3;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Coklu H.Kart" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Yukleme" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Kirmizi outline -->
                        <Button Style="{StaticResource OutlineMenuBtn}"
                                BorderBrush="#DC3545" Foreground="#DC3545"
                                Command="{Binding VoidLastActionCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x274C;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Satir" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Iptal" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sari outline -->
                        <Button Style="{StaticResource OutlineMenuBtn}"
                                BorderBrush="#FFC107" Foreground="#B8860B"
                                Command="{Binding SuspendOrResumeCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F511;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Askiya Al" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="/ Cagir" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding OpenCashDrawerCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4B0;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cekmece" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Ac" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding PriceCheckCommand}"
                                ToolTip="Barkod alanindaki urunun fiyatini gosterir">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F50D;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fiyat" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Gor" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding OpenLastReceiptCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x23EA;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Onceki" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Belgeye Donus" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineMenuBtn}" Command="{Binding OpenExchangeCommand}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F504;" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Eski Belgeye" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Degisim" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════ Arac panelleri (Islemler menusu / alt cubuk) - ZIndex 40 ══════════ -->

        <!-- Fatura alici bilgisi -->
        <Grid Grid.Row="1" Panel.ZIndex="40"
              Visibility="{Binding IsInvoicePanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.45"/>
            <Border Background="White" CornerRadius="8" Width="520" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="FATURA BILGILERI" FontSize="16" FontWeight="Bold" Foreground="#1A237E"/>
                    <TextBlock Text="Belge e-Arsiv fatura bilgisiyle kesilir; alici bilgisi belgeye basilir."
                               FontSize="11" Foreground="#757575" Margin="0,2,0,14" TextWrapping="Wrap"/>
                    <TextBlock Text="Alici Adi Soyadi / Unvani" FontSize="11" Foreground="#616161"/>
                    <TextBox FontSize="16" Padding="8,6" Margin="0,2,0,10" GotFocus="TextBox_GotFocus_OpenKeyboard"
                             Text="{Binding InvoiceBuyerName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TCKN (11) / VKN (10)" FontSize="11" Foreground="#616161"/>
                            <TextBox FontSize="16" Padding="8,6" Margin="0,2,0,0" MaxLength="11"
                                     GotFocus="TextBox_GotFocus_OpenKeyboard"
                                     Text="{Binding InvoiceTaxId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vergi Dairesi (kurumsal)" FontSize="11" Foreground="#616161"/>
                            <TextBox FontSize="16" Padding="8,6" Margin="0,2,0,0"
                                     GotFocus="TextBox_GotFocus_OpenKeyboard"
                                     Text="{Binding InvoiceTaxOffice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Adres" FontSize="11" Foreground="#616161"/>
                    <TextBox FontSize="14" Padding="8,6" Margin="0,2,0,10" Height="60"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             GotFocus="TextBox_GotFocus_OpenKeyboard"
                             Text="{Binding InvoiceAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding InvoiceError}" Foreground="#DC3545" FontSize="12" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Visibility="{Binding InvoiceError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <UniformGrid Columns="2">
                        <Button Content="Vazgec" Background="#6C757D" Style="{StaticResource RightPanelBtn}"
                                Margin="0,0,4,0" Padding="0,12" Command="{Binding CancelInvoiceCommand}"/>
                        <Button Content="Faturayla Devam Et" Background="#1565C0" Style="{StaticResource RightPanelBtn}"
                                Margin="4,0,0,0" Padding="0,12" Command="{Binding ConfirmInvoiceCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ulke secimi -->
        <Grid Grid.Row="1" Panel.ZIndex="40"
              Visibility="{Binding IsCountryPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.45"/>
            <Border Background="White" CornerRadius="8" Width="560" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="MUSTERI ULKESI" FontSize="16" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Countries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Background="#17A2B8" Style="{StaticResource RightPanelBtn}"
                                        Margin="3" Padding="0,14"
                                        Command="{Binding DataContext.SelectCountryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Vazgec" Background="#6C757D" Style="{StaticResource RightPanelBtn}"
                            Margin="3,10,3,0" Padding="0,12" Command="{Binding CloseCountryPanelCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Satis danismani (Personel) -->
        <Grid Grid.Row="1" Panel.ZIndex="40"
              Visibility="{Binding IsSalesPersonPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.45"/>
            <Border Background="White" CornerRadius="8" Width="380" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="SATIS DANISMANI" FontSize="16" FontWeight="Bold" Foreground="#1A237E"/>
                    <TextBlock Text="Satisa yardimci olan personelin numarasi (bos birakirsaniz kaldirilir)."
                               FontSize="11" Foreground="#757575" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <TextBox x:Name="SalesPersonBox" FontSize="22" FontWeight="Bold" Padding="8,6" MaxLength="10"
                             Margin="0,0,0,10" HorizontalContentAlignment="Right"
                             Text="{Binding SalesPersonInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <UniformGrid Columns="4" Rows="3" Height="160" Margin="0,0,0,10">
                        <Button Content="1" Tag="sp-1" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="2" Tag="sp-2" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="3" Tag="sp-3" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="&#x2190;" Tag="sp-backspace" Style="{StaticResource NumBtn}" Background="#DC3545" Foreground="White"/>
                        <Button Content="4" Tag="sp-4" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="5" Tag="sp-5" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="6" Tag="sp-6" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="0" Tag="sp-0" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="7" Tag="sp-7" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="8" Tag="sp-8" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="9" Tag="sp-9" Style="{StaticResource NumBtn}" Background="#007BFF" Foreground="White"/>
                        <Button Content="C" Tag="sp-clear" Style="{StaticResource NumBtn}" Background="#DC3545" Foreground="White"/>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Button Content="Vazgec" Background="#6C757D" Style="{StaticResource RightPanelBtn}"
                                Margin="0,0,4,0" Padding="0,12" Command="{Binding CancelSalesPersonCommand}"/>
                        <Button Content="Kaydet" Background="#28A745" Style="{StaticResource RightPanelBtn}"
                                Margin="4,0,0,0" Padding="0,12" Command="{Binding ConfirmSalesPersonCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Askidaki sepetler -->
        <Grid Grid.Row="1" Panel.ZIndex="40"
              Visibility="{Binding IsSuspendedListOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.45"/>
            <Border Background="White" CornerRadius="8" Width="600" MaxHeight="560" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ASKIDAKI SEPETLER" FontSize="16" FontWeight="Bold"
                               Foreground="#1A237E" Margin="0,0,0,10"/>
                    <Button DockPanel.Dock="Bottom" Content="Kapat" Background="#6C757D" Style="{StaticResource RightPanelBtn}"
                            Margin="0,10,0,0" Padding="0,12" Command="{Binding CloseSuspendedListCommand}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SuspendedCarts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#212121">
                                                    <Run Text="No "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                    <Run Text=" - "/><Run Text="{Binding Note, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#757575"
                                                           Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Cagir" Background="#28A745"
                                                    Style="{StaticResource RightPanelBtn}" Padding="18,10"
                                                    Command="{Binding DataContext.ResumeSuspendedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Onceki belge -->
        <Grid Grid.Row="1" Panel.ZIndex="40"
              Visibility="{Binding IsLastReceiptOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.45"/>
            <Border Background="White" CornerRadius="8" Width="620" MaxHeight="560" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="ONCEKI BELGE" FontSize="16" FontWeight="Bold" Foreground="#1A237E"/>
                        <TextBlock FontSize="12" Foreground="#424242">
                            <Run Text="Fis: "/><Run Text="{Binding LastReceipt.ReceiptNumber, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="   "/><Run Text="{Binding LastReceipt.SaleDate, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                            <Run Text="   Toplam: "/><Run Text="{Binding LastReceipt.FinalAmount, Mode=OneWay, Converter={StaticResource DecimalToCurrencyConverter}}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                        <Button Content="Kapat" Background="#6C757D" Style="{StaticResource RightPanelBtn}"
                                Margin="0,0,4,0" Padding="0,12" Command="{Binding CloseLastReceiptCommand}"/>
                        <Button Content="Bu Belgeden Iade / Degisim" Background="#E65100" Style="{StaticResource RightPanelBtn}"
                                Margin="4,0,0,0" Padding="0,12" Command="{Binding ExchangeFromLastReceiptCommand}"/>
                    </UniformGrid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LastReceipt.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="10" Foreground="#757575">
                                                <Run Text="{Binding Barcode, Mode=OneWay}"/><Run Text="  "/>
                                                <Run Text="{Binding Color, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Size, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text=" AD"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"
                                                   Text="{Binding LineTotal, Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Hizli urunler -->
        <Grid Grid.Row="1" Panel.ZIndex="40"
              Visibility="{Binding IsQuickProductsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#000000" Opacity="0.45"/>
            <Border Background="White" CornerRadius="8" Width="600" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="HIZLI URUNLER" FontSize="16" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding QuickProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="#FFC107" Style="{StaticResource RightPanelBtn}"
                                        Margin="3" Padding="6,16"
                                        Command="{Binding DataContext.AddQuickProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Label}" Foreground="#212121" TextWrapping="Wrap"
                                               TextAlignment="Center" FontWeight="Bold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Kapat" Background="#6C757D" Style="{StaticResource RightPanelBtn}"
                            Margin="3,10,3,0" Padding="0,12" Command="{Binding ToggleQuickProductsCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Overlay: Ara Toplam (ZIndex 30, tam sayfa - modal degil) ── -->
        <Grid Grid.Row="1" Panel.ZIndex="30"
              Visibility="{Binding IsSubTotalOpen,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#F0F2F5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ── Sol: Sepet Ozeti (salt okunur) ── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A237E" Padding="14,10">
                        <Grid>
                            <TextBlock Text="ARA TOPLAM" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#90CAF9">
                                <Run Text="Parca Adet: "/>
                                <Run Text="{Binding LineCount, Mode=OneWay}" FontWeight="Bold" Foreground="White"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding CartItems}" Margin="6,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" CornerRadius="6" Padding="12,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReturnItem}" Value="True">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#212121"
                                                           TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding ProductName}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="#757575" Margin="0,2,0,0">
                                                    <Run Text="{Binding Barcode, Mode=OneWay}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding Color, Mode=OneWay}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding Size, Mode=OneWay}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                    <Run Text=" AD"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#E65100" Margin="0,2,0,0"
                                                               Visibility="{Binding IsReturnItem, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Run Text="IADE"/>
                                                    <Run Text="{Binding SourceReceiptNumber, Mode=OneWay, StringFormat=' - Fis: {0}', TargetNullValue=' - Fissiz'}"/>
                                                    <Run Text="{Binding ReturnReasonName, Mode=OneWay, StringFormat=' | {0}'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       FontSize="15" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1A237E"/>
                                                            <Setter Property="Text"
                                                                Value="{Binding LineTotal, Mode=OneWay,
                                                                    Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Kampanya/Indirim Bandi - sadece indirimli satirlarda gorunur -->
                                            <Border Background="#17A2B8" CornerRadius="4"
                                                Padding="8,4" Margin="0,6,0,0"
                                                Visibility="{Binding HasDiscount,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White">
                                                <Run Text="&#x1F3F7; Kampanya: "/>
                                                <Run Text="{Binding DiscountAmount, Mode=OneWay,
                                                    Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                                <Run Text=" Indirim"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ── Sag: Indirim Dokumu + Numpad ── -->
                <Border Grid.Column="1" Background="#F5F5F5"
                        BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dokum (sol, kenarlikli beyaz kutu) + Indirim Butonlari (sag) -->
                        <Grid Grid.Row="0" Background="White" Margin="10,10,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol: Indirim Dokumu Kutusu -->
                            <Border Grid.Column="0" Background="White"
                                    BorderBrush="#EAEAEA" BorderThickness="1"
                                    Padding="10" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding HasPendingExchange, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Yeni satis:" FontSize="12" Foreground="#1565C0"/>
                                            <TextBlock Text="{Binding SaleOnlyTotal, Mode=OneWay, Converter={StaticResource DecimalToCurrencyConverter}}"
                                                       FontSize="12" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Iade:" FontSize="12" Foreground="#E65100"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right">
                                                <Run Text="-"/><Run Text="{Binding ReturnOnlyTotal, Mode=OneWay, Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="&#x03A3; Ara Toplam:" FontSize="12" Foreground="#212121"/>
                                        <TextBlock Text="{Binding FinalAmount, Mode=OneWay,
                                                       Converter={StaticResource DecimalToCurrencyConverter}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#212121"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Tek gercek indirim satiri (ViewModel'de sadece bu var) -->
                                    <Grid Margin="0,0,0,6"
                                          Visibility="{Binding SubTotalDiscountLabel,
                                              Converter={StaticResource StringToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F3F7; " FontSize="12"/>
                                            <TextBlock Text="{Binding SubTotalDiscountLabel}"
                                                       FontSize="12" Foreground="#DC3545"/>
                                            <Button Focusable="False" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Margin="6,0,0,0" Padding="0"
                                                    Command="{Binding RemoveSubDiscountCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock Text="[Kaldir]" FontSize="9" Foreground="#DC3545"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SubTotalDiscountAmount, Mode=OneWay,
                                                       StringFormat='-{0:N2} TL'}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#DC3545"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Height="1" Background="#EAEAEA" Margin="0,2,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Toplam:" FontSize="12" FontWeight="Bold" Foreground="#212121"/>
                                        <TextBlock Text="{Binding NetTotal, Mode=OneWay,
                                                       Converter={StaticResource DecimalToCurrencyConverter}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#212121"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="Net eksi: fark musteriye iade edilir" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,6"
                                               Visibility="{Binding IsRefundToCustomer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Grid>
                                        <TextBlock Text="NET TOPLAM" FontSize="13" FontWeight="Bold" Foreground="#1A237E"/>
                                        <TextBlock Text="{Binding NetTotal, Mode=OneWay,
                                                       Converter={StaticResource DecimalToCurrencyConverter}}"
                                                   FontSize="18" FontWeight="Bold" Foreground="#00897B"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sag: Indirim Butonlari, kareye yakin -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="Toplam Indirim" Background="#17A2B8"
                                        Style="{StaticResource RightPanelBtn}" FontSize="11"
                                        Width="90" MinHeight="80" Margin="0,0,0,8"
                                        Command="{Binding OpenSubDiscountCommand}"
                                        CommandParameter="amount"/>
                                <Button Content="Yuzde Indirim" Background="#17A2B8"
                                        Style="{StaticResource RightPanelBtn}" FontSize="11"
                                        Width="90" MinHeight="80"
                                        Command="{Binding OpenSubDiscountCommand}"
                                        CommandParameter="percent"/>
                            </StackPanel>
                        </Grid>

                        <!-- Indirim Tutari Girisi -->
                        <Border Grid.Row="1" Padding="6,0,6,6"
                                Visibility="{Binding IsSubDiscountPanelOpen,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBox x:Name="SubDiscountInputBox"
                                     FontSize="20" FontWeight="Bold"
                                     Foreground="#1A237E" Background="White"
                                     CaretBrush="#1A237E" BorderBrush="#1A237E"
                                     BorderThickness="0,0,0,2" Padding="8,6"
                                     HorizontalAlignment="Stretch" MinHeight="50"
                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                     Text="{Binding SubDiscountInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Numpad: "sub-" prefixli, SubDiscountInput'a yazar - KESIN 360x360, kare tus -->
                        <Border Grid.Row="2" Padding="6,0,6,6">
                            <UniformGrid Columns="4" Rows="4" Width="360" Height="360"
                                         HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Button Content="1" Tag="sub-1" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="2" Tag="sub-2" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="3" Tag="sub-3" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="&#x2190;" Tag="sub-backspace" Style="{StaticResource NumBtn}"
                                        Background="#DC3545" Foreground="White" Padding="0,14"/>
                                <Button Content="4" Tag="sub-4" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="5" Tag="sub-5" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="6" Tag="sub-6" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="X" Tag="sub-clear" Style="{StaticResource NumBtn}"
                                        Background="#FFC107" Foreground="#212121" Padding="0,14"/>
                                <Button Content="7" Tag="sub-7" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="8" Tag="sub-8" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="9" Tag="sub-9" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="&#x2713;" Tag="sub-enter" Style="{StaticResource NumBtn}"
                                        Background="#28A745" Foreground="White" FontSize="20" Padding="0,14"/>
                                <Button Content="," Tag="sub-comma" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="0" Tag="sub-0" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" Padding="0,14"/>
                                <Button Content="00" Tag="sub-00" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White" FontSize="15" Padding="0,14"/>
                                <Button Content="C" Tag="sub-clearall" Style="{StaticResource NumBtn}"
                                        Background="#DC3545" Foreground="White" Padding="0,14"/>
                            </UniformGrid>
                        </Border>

                        <!-- Hata Mesaji (Geri Don/Odemelere Git artik ALT BAR'da, ARA TOPLAM'in yerinde) -->
                        <Border Grid.Row="3" Background="#1A237E" Padding="10,8"
                                Visibility="{Binding ErrorMessage,
                                    Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11" Foreground="#EF9A9A"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Overlay: Odeme (ZIndex 35, ayni pencere ici mod) ── -->
        <Grid Grid.Row="1" Panel.ZIndex="35"
              Visibility="{Binding IsPaymentOpen,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#F0F2F5"/>
            <Grid DataContext="{Binding PaymentVM}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 bilerek bos - Belge Toplami/Kalan Tutar artik Sol Panel'in ICINDE -->

                <!-- Orta: 3 sutun (5*/4*/2*) -->
                <Grid Grid.Row="1" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══ SOL PANEL: Ozet + Eklenen Odemeler (beyaz fis dokumu karti) ══ -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#EAEAEA"
                            BorderThickness="1" CornerRadius="5" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ust: Belge Toplami / Kalan Tutar -->
                            <Grid Grid.Row="0" Margin="16,14,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DocumentTotalLabel}" FontSize="12" Foreground="#757575"/>
                                    <TextBlock Text="{Binding GrandTotal, Mode=OneWay,
                                                   Converter={StaticResource DecimalToCurrencyConverter}}"
                                               FontSize="26" FontWeight="Bold" Foreground="#212121"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Kalan tutar" FontSize="12" Foreground="#757575" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding RemainingAmount, Mode=OneWay,
                                                   Converter={StaticResource DecimalToCurrencyConverter}}"
                                               FontSize="26" FontWeight="Bold" Foreground="#5BC0DE" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Orta: Eklenen Odemeler (bembeyaz, bos alan) -->
                            <ListView Grid.Row="1" ItemsSource="{Binding PaymentLines}"
                                      BorderThickness="0" Background="White"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10" BorderBrush="#F0F0F0"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           FontSize="13" Foreground="#212121"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Amount, Mode=OneWay,
                                                               Converter={StaticResource DecimalToCurrencyConverter}}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="#1A237E"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Grid.Column="2" Content="X"
                                                        Width="26" Height="24"
                                                        Background="#DC3545" Foreground="White"
                                                        BorderThickness="0" FontSize="11" FontWeight="Bold"
                                                        Focusable="False" Cursor="Hand"
                                                        Command="{Binding DataContext.RemovePaymentLineCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Alt: Kupon + Musteriye Iade paneli + Odemeler Toplami -->
                            <StackPanel Grid.Row="2" Margin="16,10,16,14">
                                <!-- Uygulanan kupon -->
                                <Border Background="#FFF3E0" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                                        Visibility="{Binding HasCoupon, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <TextBlock FontSize="12" Foreground="#E65100" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="Kupon "/>
                                            <Run Text="{Binding AppliedCouponCode, Mode=OneWay}"/>
                                            <Run Text=": -"/>
                                            <Run Text="{Binding CouponDiscount, Mode=OneWay, StringFormat={}{0:N2} TL}"/>
                                        </TextBlock>
                                        <Button Content="Kaldir" HorizontalAlignment="Right" Background="#DC3545"
                                                Style="{StaticResource RightPanelBtn}" Padding="10,4" FontSize="11"
                                                Command="{Binding RemoveCouponCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- Musteriye iade (degisimde iade > yeni satis ya da saf iade).
                                     Eskiden bu secim ekranda YOKTU: kasiyer iadenin nakit/kart/hediye
                                     kartina mi yapilacagini secemiyor, "Kalan 0" gorup ne yapacagini
                                     bilemiyordu (ViewModel'de destek vardi, UI yoktu). -->
                                <Border Background="#FFF8E1" BorderBrush="#E65100" BorderThickness="2"
                                        CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                        Visibility="{Binding HasAmountOwed, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#E65100">
                                            <Run Text="Musteriye iade: "/>
                                            <Run Text="{Binding AmountOwedToCustomer, Mode=OneWay, Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                        </TextBlock>
                                        <TextBlock Text="Iade yontemi:" FontSize="11" Foreground="#757575" Margin="0,8,0,4"/>
                                        <UniformGrid Columns="3">
                                            <Button Content="Nakit" Margin="0,0,4,0" Padding="0,10"
                                                    Command="{Binding SelectOwedRefundMethodCommand}" CommandParameter="Cash">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RightPanelBtn}">
                                                        <Setter Property="Background" Value="#90A4AE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOwedCash}" Value="True">
                                                                <Setter Property="Background" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Karta" Margin="2,0" Padding="0,10"
                                                    ToolTip="Sadece orijinal satista kartla odenen tutar kadar"
                                                    Command="{Binding SelectOwedRefundMethodCommand}" CommandParameter="Card">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RightPanelBtn}">
                                                        <Setter Property="Background" Value="#90A4AE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOwedCard}" Value="True">
                                                                <Setter Property="Background" Value="#1565C0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Hediye Karti" Margin="4,0,0,0" Padding="0,10"
                                                    Command="{Binding SelectOwedRefundMethodCommand}" CommandParameter="GiftCard">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RightPanelBtn}">
                                                        <Setter Property="Background" Value="#90A4AE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOwedGiftCard}" Value="True">
                                                                <Setter Property="Background" Value="#6A1B9A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </UniformGrid>
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsOwedGiftCard, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Hediye karti numarasi" FontSize="11" Foreground="#757575" Margin="0,0,0,2"/>
                                            <TextBox FontSize="16" FontWeight="Bold" Padding="6,4"
                                                     BorderBrush="#6A1B9A" BorderThickness="0,0,0,2"
                                                     Text="{Binding OwedGiftCardInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <Button Content="IADEYI TAMAMLA" Background="#E65100" Margin="0,10,0,0"
                                                Style="{StaticResource RightPanelBtn}" FontSize="15" Padding="0,14"
                                                Command="{Binding CompleteSaleCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Iade kredisi yeni satisi tam karsiliyor: tahsilat/iade yok -->
                                <Border Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="2"
                                        CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                        Visibility="{Binding IsZeroBalanceExchange, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Iade tutari yeni satisi tam karsiliyor. Tahsilat yok."
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" TextWrapping="Wrap"/>
                                        <Button Content="DEGISIMI TAMAMLA" Background="#2E7D32" Margin="0,10,0,0"
                                                Style="{StaticResource RightPanelBtn}" FontSize="15" Padding="0,14"
                                                Command="{Binding CompleteSaleCommand}"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel HorizontalAlignment="Right"
                                            Visibility="{Binding CanTakePayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Odemeler Toplami" FontSize="12" Foreground="#757575"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding PaidTotal, Mode=OneWay,
                                                   Converter={StaticResource DecimalToCurrencyConverter}}"
                                               FontSize="20" FontWeight="Bold" Foreground="#212121"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ ORTA PANEL: Giris + Numpad (renkli, KESIN 360x360 kare) ══ -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#EAEAEA" BorderThickness="1" Margin="0,0,6,0" Padding="10">
                        <Grid Width="360" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bilgi ekrani (bos, bilgi amacli beyaz kutu) -->
                            <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#EAEAEA"
                                    BorderThickness="1" MinHeight="30" Margin="0,0,0,8"/>

                            <TextBox Grid.Row="1" x:Name="PaymentAmountBox"
                                     FontSize="26" FontWeight="Bold"
                                     Foreground="#212121" Background="White"
                                     CaretBrush="#007BFF" BorderBrush="#007BFF"
                                     BorderThickness="2" Padding="10,8"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                     Height="60"
                                     Margin="0,0,0,15"
                                     Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Numpad: KESIN 360x360 -> 4x4'te tam 90x90 kare tuslar -->
                            <Grid Grid.Row="2" Width="360" Height="360">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="1" Tag="pay-1" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Tag="pay-2" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Tag="pay-3" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="0" Grid.Column="3" Content="&#x2190;" Tag="pay-backspace" Style="{StaticResource NumBtn}"
                                        Background="#DC3545" Foreground="White"/>

                                <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="pay-4" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="pay-5" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="pay-6" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="X" Tag="pay-clear" Style="{StaticResource NumBtn}"
                                        Background="#FFC107" Foreground="#212121"/>

                                <Button Grid.Row="2" Grid.Column="0" Content="7" Tag="pay-7" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Tag="pay-8" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Tag="pay-9" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Content="&#x2713;" Tag="pay-enter"
                                        Style="{StaticResource NumBtn}" FontSize="28"
                                        Background="#28A745" Foreground="White"/>

                                <Button Grid.Row="3" Grid.Column="0" Content="," Tag="pay-comma" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Tag="pay-0" Style="{StaticResource NumBtn}"
                                        Background="#007BFF" Foreground="White"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="C" Tag="pay-clearall" Style="{StaticResource NumBtn}"
                                        Background="#DC3545" Foreground="White"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ══ SAG PANEL: Dikey Odeme Yontemleri (musteriye iade varken pasif) ══ -->
                    <StackPanel Grid.Column="2" IsEnabled="{Binding CanTakePayment}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Turk Lirasi" Background="#007BFF" Foreground="White"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding AddCashCommand}"/>
                        <Button Content="Gider Pusulasi" Background="#FFC107" Foreground="#212121"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding AddGiderPusulasiCommand}"/>
                        <Button Content="ORTAK POS" Background="#17A2B8" Foreground="White"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding OpenPosMenuCommand}"/>
                        <Button Content="Hediye Karti" Background="#007BFF" Foreground="White"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding OpenGiftCardPanelCommand}"/>
                        <Button Content="USD" Background="#28A745" Foreground="White"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding AddUsdCommand}"/>
                        <Button Content="EUR" Background="#28A745" Foreground="White"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding AddEurCommand}"/>
                        <Button Content="Kupon" Background="#E65100" Foreground="White"
                                Style="{StaticResource RightPanelBtn}" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Command="{Binding OpenCouponPanelCommand}"/>
                        <Button Content="Tumu" Background="White" Foreground="#212121"
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                FontSize="13" FontWeight="Bold" Cursor="Hand" Focusable="False"
                                HorizontalAlignment="Stretch" MinHeight="60" Margin="0,0,0,5"
                                Tag="pay-clearall">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sadece hata mesaji - Hamburger/Geri Don artik DIS/asil alt barda (cift bar olmasin diye) -->
                <Border Grid.Row="2" Background="White" BorderBrush="#EAEAEA" BorderThickness="0,1,0,0"
                        Padding="6" MinHeight="0"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="11" Foreground="#DC3545"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Para Ustu Overlay: otomatik tamamlama sirasinda gorunur, sadece icerik
                     alanini (Row 1+2) kaplar, ust header (root Grid.Row=0) etkilenmez -->
                <Grid Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="50"
                      x:Name="ParaUstuOverlay"
                      Visibility="{Binding IsParaUstuVisible,
                          Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#FFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#5BC0DE" BorderThickness="1"
                                Background="White" Padding="40,20">
                            <TextBlock Text="{Binding ParaUstuText}"
                                       FontSize="36" Foreground="#DC3545"
                                       FontWeight="Bold"/>
                        </Border>
                        <ProgressBar IsIndeterminate="True" Width="60" Height="6"
                                     Margin="0,30,0,0"
                                     HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Ic Overlay: POS Menusu - Satis / Taksit (ZIndex 36) -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="36"
                      Visibility="{Binding IsPosMenuOpen,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#000000" Opacity="0.45"/>
                    <Border Background="#1E272E" CornerRadius="10"
                            Width="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="POS ISLEM TIPI" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding RemainingAmount, Mode=OneWay,
                                           Converter={StaticResource DecimalToCurrencyConverter}}"
                                       FontSize="20" FontWeight="Bold" Foreground="#4CAF50"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Button Content="SATIS" Focusable="False" Cursor="Hand"
                                    Background="#00897B" Style="{StaticResource RightPanelBtn}"
                                    FontSize="15" Padding="0,16" Margin="0,0,0,8"
                                    Command="{Binding PosSaleCommand}"/>
                            <Button Content="TAKSIT" Focusable="False" Cursor="Hand"
                                    Background="#1565C0" Style="{StaticResource RightPanelBtn}"
                                    FontSize="15" Padding="0,16" Margin="0,0,0,14"
                                    Command="{Binding OpenInstallmentMenuCommand}"/>
                            <Button Content="Vazgec" Focusable="False" Cursor="Hand"
                                    Background="#37474F" Style="{StaticResource RightPanelBtn}"
                                    Command="{Binding ClosePosMenuCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Ic Overlay: Taksit Secenekleri (ZIndex 36) -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="36"
                      Visibility="{Binding IsInstallmentMenuOpen,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#000000" Opacity="0.45"/>
                    <Border Background="#1E272E" CornerRadius="10"
                            Width="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="TAKSIT SECENEKLERI" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="#90CAF9"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"
                                       Visibility="{Binding HasLockedInstallment,
                                           Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="Fis ekraninda secilen vade farki uygulanacak"/>
                            <ItemsControl ItemsSource="{Binding AvailableInstallmentOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Focusable="False" Cursor="Hand"
                                                Background="#1565C0" Style="{StaticResource RightPanelBtn}"
                                                FontSize="16" Padding="0,16" Margin="4"
                                                Command="{Binding DataContext.SelectPosInstallmentCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Vazgec" Focusable="False" Cursor="Hand"
                                    Background="#37474F" Style="{StaticResource RightPanelBtn}"
                                    Margin="0,14,0,0"
                                    Command="{Binding ClosePosMenuCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Ic Overlay: Kupon (ZIndex 36) -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="36"
                      Visibility="{Binding IsCouponPanelOpen,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#000000" Opacity="0.45"/>
                    <Border Background="#1E272E" CornerRadius="10"
                            Width="320"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="KUPON KODU" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox FontSize="18" FontWeight="Bold"
                                     Foreground="White" Background="#2D3748"
                                     BorderBrush="#E65100" BorderThickness="0,0,0,2"
                                     CaretBrush="White" Padding="8,6" Margin="0,0,0,14"
                                     Text="{Binding CouponInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Iptal"
                                        Background="#37474F" Style="{StaticResource RightPanelBtn}"
                                        Margin="0,0,4,0" Command="{Binding CancelCouponCommand}"/>
                                <Button Grid.Column="1" Content="Uygula"
                                        Background="#E65100" Style="{StaticResource RightPanelBtn}"
                                        Margin="4,0,0,0" Command="{Binding ApplyCouponCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Ic Overlay: Hediye Karti (ZIndex 36) -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="36"
                      Visibility="{Binding IsGiftCardPanelOpen,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#000000" Opacity="0.45"/>
                    <Border Background="#1E272E" CornerRadius="10"
                            Width="340"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="HEDIYE KARTI" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Kart Numarasi" FontSize="10"
                                       Foreground="#90CAF9" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" FontSize="16" FontWeight="Bold"
                                         Foreground="White" Background="#2D3748"
                                         BorderBrush="#6A1B9A" BorderThickness="0,0,0,2"
                                         CaretBrush="White" Padding="8,6"
                                         Text="{Binding GiftCardInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Sorgula"
                                        Background="#6A1B9A" Style="{StaticResource RightPanelBtn}"
                                        Padding="12,8" Margin="6,0,0,0"
                                        Command="{Binding QueryGiftCardCommand}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                        Visibility="{Binding IsGiftCardValid,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Bakiye: " FontSize="13" Foreground="#90CAF9"/>
                                <TextBlock Text="{Binding GiftCardBalance, Mode=OneWay,
                                               Converter={StaticResource DecimalToCurrencyConverter}}"
                                           FontSize="13" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11" Foreground="#EF9A9A"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ErrorMessage,
                                           Converter={StaticResource StringToVisibilityConverter}}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Iptal"
                                        Background="#37474F" Style="{StaticResource RightPanelBtn}"
                                        Margin="0,0,4,0" Command="{Binding CancelGiftCardCommand}"/>
                                <Button Grid.Column="1" Content="Kullan"
                                        Background="#6A1B9A" Style="{StaticResource RightPanelBtn}"
                                        Margin="4,0,0,0" Command="{Binding AddGiftCardCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── ALT ISLEM CUBUGU ── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Button Content="&#x2630;" FontSize="20" FontWeight="Bold"
                        Foreground="#212121" Background="Transparent"
                        BorderThickness="0" Width="48" Height="48"
                        HorizontalAlignment="Left" Focusable="False" Cursor="Hand"
                        Command="{Binding ToggleHamburgerMenuCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Sadece Fis ekranindayken gorunur - Ara Toplam/Odeme acikken tamamen gizli -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsOnFisScreen,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Urun Bul" Background="#6A1B9A"
                                Style="{StaticResource BottomBtn}" Padding="20,14" Margin="0,0,10,0"
                                ToolTip="Urun kodu (W6ER01Z8) / barkod / ad ile bul, renk ve beden secip sepete ekle"
                                Command="{Binding OpenProductLookupCommand}"/>
                        <Button Content="{Binding CountryButtonLabel}" Background="#17A2B8"
                                Style="{StaticResource BottomBtn}" Padding="20,14" Margin="0,0,10,0"
                                Command="{Binding OpenCountryPanelCommand}"/>
                        <Button Content="{Binding CustomerName, TargetNullValue='Musteri Sec'}"
                                Background="#007BFF"
                                Style="{StaticResource BottomBtn}" Padding="20,14" Margin="0,0,10,0"
                                Command="{Binding OpenCustomerSearchCommand}"/>
                        <Button Content="{Binding SalesPersonButtonLabel}" Background="#17A2B8"
                                Style="{StaticResource BottomBtn}" Padding="20,14" Margin="0,0,10,0"
                                Command="{Binding OpenSalesPersonPanelCommand}"/>
                        <Button Content="Belge Iptal" Background="#DC3545"
                                Style="{StaticResource BottomBtn}" Padding="20,14" Margin="0,0,10,0"
                                Command="{Binding ClearCartCommand}"/>
                        <Button Content="Islem Secimi" Background="#FFC107" Foreground="#212121"
                                Style="{StaticResource BottomBtn}" Padding="20,14" Margin="0,0,20,0"
                                Command="{Binding ToggleHamburgerMenuCommand}"/>
                    </StackPanel>

                    <!-- Fis ekranindayken: ARA TOPLAM -->
                    <Button Content="ARA TOPLAM" Background="#28A745"
                            FontSize="15" FontWeight="Bold"
                            Padding="24,12" Command="{Binding OpenSubTotalCommand}"
                            Visibility="{Binding IsOnFisScreen,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Ara Toplam ekrani acikken: ARA TOPLAM'in yerinde Geri Don / Odemelere Git ikilisi -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSubTotalOpen,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Geri Don" Background="#FFC107" Foreground="#212121"
                                Style="{StaticResource BottomBtn}" FontSize="14" FontWeight="Bold"
                                Padding="20,12" Margin="0,0,8,0"
                                Command="{Binding CloseSubTotalCommand}"/>
                        <Button Content="Odemelere Git" Background="#28A745" Foreground="White"
                                Style="{StaticResource BottomBtn}" FontSize="14" FontWeight="Bold"
                                Padding="20,12" Command="{Binding ProceedToPaymentCommand}"/>
                    </StackPanel>

                    <!-- Odeme ekrani acikken: kucuk, kareye yakin, saga yasli Geri Don -->
                    <Button Content="Geri Don" Background="#FFC107" Foreground="#212121"
                            Style="{StaticResource BottomBtn}" FontSize="13" FontWeight="Bold"
                            Width="100" MinHeight="70" HorizontalAlignment="Right"
                            Command="{Binding PaymentVM.GoBackCommand}"
                            Visibility="{Binding IsPaymentOpen,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    <!-- Urun Bul / Fiyat Gor: urun kodu (W6ER01Z8) -> renk -> beden (en ust katman) -->
    <views:ProductLookupPanel Grid.RowSpan="3" Panel.ZIndex="70" DataContext="{Binding LookupVM}"/>
    </Grid>
</Window>
