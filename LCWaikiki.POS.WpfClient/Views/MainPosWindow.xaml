        </Grid>
        <!-- ── Fis ekrani mesaj seridi: hata (kirmizi) / bilgi (yesil). Eskiden Fis
             ekraninda MainPosViewModel.ErrorMessage/SuccessMessage hic gosterilmiyordu
             ("Urun bulunamadi", degisim sonucu vb. kasiyere ulasmiyordu). Dokununca kapanir. ── -->
        <StackPanel Grid.Row="1" Panel.ZIndex="15" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    MaxWidth="620" Margin="0,0,16,16"
                    Visibility="{Binding IsOnFisScreen, Converter={StaticResource BoolToVisibilityConverter}}">
