            <Border Background="#2E7D32" CornerRadius="6" Padding="16,8" Margin="0,6,0,0" Cursor="Hand"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DismissSuccessMessageCommand}"/>
                </Border.InputBindings>
                <TextBlock Text="{Binding SuccessMessage}" FontSize="13" FontWeight="SemiBold"
                           Foreground="White" TextWrapping="Wrap"/>
