<Window x:Class="LCWaikiki.POS.WpfClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPOS - Giris" Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A237E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="WPOS" FontSize="44" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Kasa Sistemi" FontSize="13" Foreground="#90CAF9"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Login Karti -->
        <Border Grid.Row="1" Background="White" CornerRadius="12"
                Margin="24,0,24,12" Padding="24">
            <StackPanel>

                <TextBlock Text="Kasiyer Girisi" FontSize="17" FontWeight="SemiBold"
                           Foreground="#1A237E" HorizontalAlignment="Center"
                           Margin="0,0,0,14"/>

                <TextBlock Text="Kullanici Kodu" FontSize="12"
                           Foreground="#616161" Margin="0,0,0,4"/>
                <TextBox x:Name="PersonelIdBox"
         FontSize="16" Padding="10,8"
         BorderBrush="#1A237E" BorderThickness="1.5"
         Text="{Binding PersonelId, UpdateSourceTrigger=PropertyChanged}"
         IsReadOnly="{Binding IsChangePinMode}"
         GotFocus="PersonelIdBox_GotFocus"
         Margin="0,0,0,12"/>

                <!-- Ilk giris: zorunlu PIN degistirme bilgisi -->
                <Border Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding IsChangePinMode,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding InfoMessage}" FontSize="12" Foreground="#6D4C41"
                                   TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" Foreground="#8D6E63" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Tek rakam tekrari (1111) veya ardisik (1234) PIN kabul edilmez."/>
                        <Button Content="Vazgec ve cikis yap" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Focusable="False" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Foreground="#1565C0" FontSize="11" Padding="0"
                                Command="{Binding CancelChangePinCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding PinPrompt}" FontSize="12"
                           Foreground="#616161" Margin="0,0,0,4"/>
                <Border BorderBrush="#1A237E" BorderThickness="1.5"
        CornerRadius="3" Padding="10,8" Margin="0,0,0,14"
        Cursor="IBeam"
        MouseLeftButtonDown="PinArea_Click">
                    <TextBlock Text="{Binding PinDisplay}"
               FontSize="22" FontFamily="Courier New"
               Foreground="#1A237E" MinHeight="26"/>
                </Border>

                <!-- Numpad — Focusable=False ile focus calmiyor -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="1"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="2"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="3"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="&#x2190;" Margin="3"
                            Style="{StaticResource AccentButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding BackspaceCommand}"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="5"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="6"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="X" Margin="3"
                            Style="{StaticResource DangerButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding ClearCommand}"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="7"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="8"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="9"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="," Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            IsEnabled="False" Opacity="0.4"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding AppendDigitCommand}" CommandParameter="0"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="C" Margin="3"
                            Style="{StaticResource PosButton}" FontSize="18"
                            Focusable="False"
                            Command="{Binding ClearCommand}"/>
                    <Button Grid.Row="3" Grid.Column="3" Content="&#x2713;" Margin="3"
                            Style="{StaticResource SuccessButton}" FontSize="22"
                            Focusable="False"
                            Command="{Binding LoginCommand}"/>
                </Grid>

                <Border Background="#FFEBEE" CornerRadius="4" Padding="10,6"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Giris yapiliyor..." FontSize="13"
                           Foreground="#1565C0" HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsBusy,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="LC Waikiki WPOS v1.0"
                   Foreground="#90CAF9" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>