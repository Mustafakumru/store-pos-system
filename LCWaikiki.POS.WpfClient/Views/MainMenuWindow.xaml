<Window x:Class="LCWaikiki.POS.WpfClient.Views.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:http="clr-namespace:LCWaikiki.POS.WpfClient.Core.Http"
        xmlns:offline="clr-namespace:LCWaikiki.POS.WpfClient.Core.Offline"
        xmlns:views="clr-namespace:LCWaikiki.POS.WpfClient.Views"
        Title="WPOS - Ana Menu"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#ECEFF1">

    <Window.Resources>
        <Style x:Key="GroupHeader" TargetType="Border">
            <Setter Property="Background" Value="#1A237E"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="GroupBody" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                      Color="#BDBDBD" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnBlue"   BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
        </Style>
        <Style x:Key="BtnOrange" BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#E65100"/>
        </Style>
        <Style x:Key="BtnGreen"  BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
        </Style>
        <Style x:Key="BtnTeal"   BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#00695C"/>
        </Style>
        <Style x:Key="BtnGray"   BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#546E7A"/>
        </Style>
        <Style x:Key="BtnRed"    BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#B71C1C"/>
        </Style>
        <Style x:Key="BtnAmber"  BasedOn="{StaticResource MenuBtn}" TargetType="Button">
            <Setter Property="Background" Value="#F57F17"/>
        </Style>
        <Style x:Key="BottomBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ── Ust Cubuk ── -->
        <Border Grid.Row="0" Background="#1A237E">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Logo + Kullanici Bilgisi -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF22" CornerRadius="4"
                            Padding="8,4" Margin="0,0,12,0">
                        <TextBlock Text="WPOS" FontSize="22" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CashierName}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding StoreName}"
                                   FontSize="11" Foreground="#90CAF9"/>
                    </StackPanel>
                </StackPanel>

                <!-- Orta: Kasa oturumu durumu -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="14" Padding="14,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#B71C1C"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSessionOpen}" Value="True">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SessionStatusText}" Foreground="White"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- Sag: Saat + Durum -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Border Background="#FFFFFF15" CornerRadius="4"
                            Padding="12,6" Margin="0,0,10,0">
                        <TextBlock x:Name="ClockText"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="White" FontFamily="Consolas"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#4CAF50"/>
                            <Setter Property="ToolTip" Value="Sunucu baglantisi var"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline, Source={x:Static http:ConnectivityMonitor.Instance}}" Value="False">
                                    <Setter Property="Fill" Value="#DC3545"/>
                                    <Setter Property="ToolTip" Value="Sunucuya ulasilamiyor"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                            <TextBlock Text="{Binding StatusText, Source={x:Static http:ConnectivityMonitor.Instance}}"
                                       FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A5D6A7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline, Source={x:Static http:ConnectivityMonitor.Instance}}" Value="False">
                                                <Setter Property="Foreground" Value="#FF8A80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText, Source={x:Static offline:OfflineSaleQueue.Current}}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#FFB74D" Margin="0,2,0,0" VerticalAlignment="Center"
                               ToolTip="Sunucuya gonderilmemis cevrimdisi satislar (Ana Menu > Cevrimdisi Satislar)"
                               Visibility="{Binding HasPending, Source={x:Static offline:OfflineSaleQueue.Current}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Content="Cevrimdisi Satislar" Command="{Binding OfflineVM.OpenCommand}"
                            Margin="12,0,0,0" Padding="10,6" FontSize="11" Focusable="False"
                            Background="#FFFFFF22" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Ana Icerik ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="16,12,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Sutun 1: Belge ── -->
                <StackPanel Grid.Column="0" Margin="5">
                    <Border Style="{StaticResource GroupHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C4;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BELGE" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBody}">
                        <UniformGrid Columns="2" Rows="5">
                            <Button Content="Fis" Style="{StaticResource BtnBlue}"
                                    Command="{Binding OpenPosCommand}"/>
                            <Button Content="Fatura" Style="{StaticResource BtnGray}"
                                    Command="{Binding OpenInvoiceSaleCommand}"/>
                            <Button Content="Iade" Style="{StaticResource BtnOrange}"
                                    Command="{Binding OpenExchangeCommand}"/>
                            <Button Content="Iade-Degisim" Style="{StaticResource BtnOrange}"
                                    Command="{Binding OpenExchangeCommand}"/>
                            <Button Content="Tax Free" Style="{StaticResource BtnGray}"
                                    ToolTip="Yurt disi musteri: Fis ekrani ulke secimiyle acilir"
                                    Command="{Binding OpenTaxFreeSaleCommand}"/>
                            <Button Content="Istisnai Satis" Style="{StaticResource BtnGreen}"
                                    ToolTip="Yonetici onayli ozel fiyatli satis"
                                    Command="{Binding OpenExceptionalSaleCommand}"/>
                            <Button Content="Fiyat Gor" Style="{StaticResource BtnBlue}"
                                    Command="{Binding OpenPriceCheckCommand}"/>
                            <Button Content="H.Kart Sorgu" Style="{StaticResource BtnTeal}"
                                    Command="{Binding OpenGiftCardQueryCommand}"/>
                            <Button Content="H.Kart Satis" Style="{StaticResource BtnGreen}"
                                    ToolTip="Hediye karti satisi / bakiye yukleme (emanet - ciroya girmez)"
                                    Command="{Binding OpenGiftCardSaleCommand}"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- ── Sutun 2: OKC ── -->
                <StackPanel Grid.Column="1" Margin="5">
                    <Border Style="{StaticResource GroupHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F5A8;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OKC" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBody}">
                        <UniformGrid Columns="2" Rows="3">
                            <Button Content="Z Raporu" Style="{StaticResource BtnTeal}"
                                    Command="{Binding ZReportCommand}"/>
                            <Button Content="X Raporu" Style="{StaticResource BtnTeal}"
                                    Command="{Binding XReportCommand}"/>
                            <Button Content="Mali Rapor" Style="{StaticResource BtnTeal}"
                                    Command="{Binding OpenFinancialReportCommand}"/>
                            <Button Content="Son Belge Tekrari" Style="{StaticResource BtnTeal}"
                                    Command="{Binding ReprintLastCommand}"/>
                            <Button Content="Kasa Raporu" Style="{StaticResource BtnTeal}"
                                    Command="{Binding CashReportCommand}"/>
                            <Button Content="Kasa Kapanis" Style="{StaticResource BtnAmber}"
                                    Command="{Binding OpenCashSessionCommand}"
                                    CommandParameter="close"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- ── Sutun 3: EFT-POS ── -->
                <StackPanel Grid.Column="2" Margin="5">
                    <Border Style="{StaticResource GroupHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4B3;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="EFT-POS" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBody}">
                        <UniformGrid Columns="2" Rows="3">
                            <Button Content="Pos Gunsonu" Style="{StaticResource BtnGray}" Command="{Binding PosEndOfDayCommand}"/>
                            <Button Content="Pos Gunsonu Tekrar" Style="{StaticResource BtnGray}" Command="{Binding PosEndOfDayRepeatCommand}"/>
                            <Button Content="Eksik Gun Sonu" Style="{StaticResource BtnGray}" Command="{Binding MissingEndOfDayCommand}"/>
                            <Button Content="Parametre Guncelle" Style="{StaticResource BtnGray}" Command="{Binding ReloadParametersCommand}"/>
                            <Button Content="Pos Gunortasi" Style="{StaticResource BtnGray}" Command="{Binding PosMidDayCommand}"/>
                            <Button Content="" Style="{StaticResource BtnGray}"
                                    IsEnabled="False" Opacity="0"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- ── Sutun 4: Avans / Teslim ── -->
                <StackPanel Grid.Column="3" Margin="5">
                    <Border Style="{StaticResource GroupHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4B0;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AVANS / TESLIM" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupBody}">
                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="Avans" Style="{StaticResource BtnTeal}"
                                    Command="{Binding OpenCashSessionCommand}"
                                    CommandParameter="open"/>
                            <Button Content="Teslim" Style="{StaticResource BtnAmber}"
                                    Command="{Binding OpenCashSessionCommand}"
                                    CommandParameter="close"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ── Bilgi seridi (kasa acildi / teslim kaydedildi) - dokununca kapanir ── -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="20,0,20,12"
                Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="1"
                CornerRadius="6" Padding="16,10" Cursor="Hand"
                Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding DismissInfoCommand}"/>
            </Border.InputBindings>
            <TextBlock Text="{Binding InfoMessage}" FontSize="14" FontWeight="SemiBold"
                       Foreground="#2E7D32" TextWrapping="Wrap"/>
        </Border>

        <!-- ── Avans / Teslim paneli ── -->
        <Grid Grid.RowSpan="3" Background="#99000000"
              Visibility="{Binding IsCashPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="10" Width="460" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding CashPanelTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="#1A237E"/>
                    <TextBlock Text="{Binding CashPanelHint}" FontSize="12" Foreground="#616161"
                               TextWrapping="Wrap" Margin="0,6,0,16"/>

                    <StackPanel Visibility="{Binding ShowAmountField, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding AmountLabel}" FontSize="12" Foreground="#424242" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22" FontWeight="Bold" Padding="10,6" Margin="0,0,0,16"/>
                    </StackPanel>

                    <Border Background="#F5F5F5" CornerRadius="6" Padding="12"
                            Visibility="{Binding ShowApprovalFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="MAGAZA MUDURU ONAYI" FontSize="11" FontWeight="Bold"
                                       Foreground="#1A237E" Margin="0,0,0,8"/>
                            <TextBlock Text="Mudur kodu" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding ManagerPersonelId, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" Padding="8,5" Margin="0,0,0,8"/>
                            <TextBlock Text="PIN" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
                            <PasswordBox x:Name="ManagerPinBox" FontSize="16" Padding="8,5"
                                         PasswordChanged="ManagerPinBox_PasswordChanged"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CashPanelError}" Foreground="#C62828" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding CashPanelError, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <UniformGrid Columns="2" Margin="0,18,0,0" Height="48">
                        <Button Content="Vazgec" Style="{StaticResource BtnGray}"
                                Command="{Binding CancelCashPanelCommand}"/>
                        <Button Style="{StaticResource BtnGreen}"
                                Command="{Binding ConfirmCashPanelCommand}"
                                Content="{Binding ConfirmButtonText}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── X / Z Rapor sonucu ── -->
        <Grid Grid.RowSpan="3" Background="#99000000"
              Visibility="{Binding IsReportOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="10" Width="480" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ReportTitle}" FontSize="20" FontWeight="Bold" Foreground="#1A237E"/>
                    <TextBlock Text="{Binding ReportSubtitle}" FontSize="12" Foreground="#616161"
                               TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <ItemsControl ItemsSource="{Binding ReportLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                    <Setter Property="Background" Value="#E8EAF6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="14" Foreground="#424242"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                                                   FontFamily="Consolas" Foreground="#212121">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Kapat" Style="{StaticResource BtnBlue}" Height="46" Margin="0,18,0,0"
                            Command="{Binding CloseReportCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Hediye Karti Satisi (emanet) ── -->
        <Grid Grid.RowSpan="3" Background="#99000000"
              Visibility="{Binding IsGiftCardSaleOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="10" Width="560" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="HEDIYE KARTI SATISI" FontSize="20" FontWeight="Bold" Foreground="#1A237E"/>
                    <TextBlock FontSize="12" Foreground="#616161" TextWrapping="Wrap" Margin="0,4,0,14"
                               Text="Karti okutun, yuklenecek tutari girin, Ekle'ye basin. Birden fazla kart eklenebilir. Tutar EMANET olarak izlenir (ciroya kart harcaninca girer)."/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Kart numarasi" FontSize="11" Foreground="#616161"/>
                            <TextBox Text="{Binding GcCardInput, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Tutar (TL)" FontSize="11" Foreground="#616161"/>
                            <TextBox Text="{Binding GcAmountInput, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8,5"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Ekle" Style="{StaticResource BtnBlue}" Width="80"
                                VerticalAlignment="Bottom" Padding="8,8"
                                Command="{Binding AddGiftCardLineCommand}"/>
                    </Grid>

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" MinHeight="70" MaxHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding GcLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CardNumber}" FontSize="14" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="1" Margin="12,0"
                                                       Text="{Binding Amount, Converter={StaticResource DecimalToCurrencyConverter}}"
                                                       FontSize="14" FontWeight="Bold"/>
                                            <Button Grid.Column="2" Content="X" Width="26" Height="24" Focusable="False" Cursor="Hand"
                                                    Background="#FFEBEE" Foreground="#C62828" BorderThickness="0" FontWeight="Bold"
                                                    Command="{Binding DataContext.RemoveGiftCardLineCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="TOPLAM" FontSize="13" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="24" FontWeight="Bold" Foreground="#1A237E"
                                   Text="{Binding GcTotal, Converter={StaticResource DecimalToCurrencyConverter}}"/>
                    </Grid>

                    <TextBlock Text="Odeme" FontSize="11" Foreground="#616161" Margin="0,12,0,4"/>
                    <UniformGrid Columns="2" Height="44">
                        <Button Content="NAKIT" Command="{Binding SetGcPaymentCommand}" CommandParameter="Cash" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnGray}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GcPayByCard}" Value="False">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="KART" Command="{Binding SetGcPaymentCommand}" CommandParameter="Card" Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnGray}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GcPayByCard}" Value="True">
                                            <Setter Property="Background" Value="#1565C0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,10,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GcPayByCard}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Alinan nakit (TL)" FontSize="11" Foreground="#616161"/>
                            <TextBox Text="{Binding GcCashInput, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="Para ustu" FontSize="11" Foreground="#616161"/>
                            <TextBlock Text="{Binding GcChange, Converter={StaticResource DecimalToCurrencyConverter}}"
                                       FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding GcError}" Foreground="#C62828" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding GcError, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <UniformGrid Columns="2" Margin="0,16,0,0" Height="48">
                        <Button Content="Vazgec" Style="{StaticResource BtnGray}" Command="{Binding CancelGiftCardSaleCommand}"/>
                        <Button Content="Satisi Tamamla" Style="{StaticResource BtnGreen}" Command="{Binding CompleteGiftCardSaleCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Sifre (PIN) Degistir ── -->
        <Grid Grid.RowSpan="3" Background="#99000000"
              Visibility="{Binding IsChangePinOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="10" Width="420" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="PIN DEGISTIR" FontSize="20" FontWeight="Bold" Foreground="#1A237E"/>
                    <TextBlock Text="4-6 rakam. Tek rakam tekrari (1111) ve ardisik (1234) PIN kabul edilmez."
                               FontSize="12" Foreground="#616161" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <TextBlock Text="Mevcut PIN" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="OldPinBox" FontSize="16" Padding="8,5" Margin="0,0,0,10"
                                 PasswordChanged="ChangePinBox_PasswordChanged"/>
                    <TextBlock Text="Yeni PIN" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="NewPinBox" FontSize="16" Padding="8,5" Margin="0,0,0,10"
                                 PasswordChanged="ChangePinBox_PasswordChanged"/>
                    <TextBlock Text="Yeni PIN (tekrar)" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="NewPinRepeatBox" FontSize="16" Padding="8,5"
                                 PasswordChanged="ChangePinBox_PasswordChanged"/>
                    <TextBlock Text="{Binding ChangePinError}" Foreground="#C62828" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding ChangePinError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <UniformGrid Columns="2" Margin="0,18,0,0" Height="48">
                        <Button Content="Vazgec" Style="{StaticResource BtnGray}"
                                Command="{Binding CancelChangePinCommand}"/>
                        <Button Content="Kaydet" Style="{StaticResource BtnGreen}"
                                Command="{Binding ConfirmChangePinCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Alt Cubuk ── -->
        <Border Grid.Row="2" Background="#263238"
                BorderBrush="#37474F" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Kasiyer Cikisi"
                        Background="#B71C1C"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding LogoutCommand}"/>

                <Button Grid.Column="1"
                        Content="Sifre Degistir"
                        Background="#37474F"
                        Style="{StaticResource BottomBtn}"
                        Command="{Binding OpenChangePinCommand}"
                        Margin="8,0"/>

                <TextBlock Grid.Column="3"
                           Text="LC Waikiki POS v1.0"
                           FontSize="11" Foreground="#546E7A"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    <!-- Urun Bul / Fiyat Gor: urun kodu (W6ER01Z8) -> renk -> beden (en ust katman) -->
    <views:ProductLookupPanel Grid.RowSpan="3" Panel.ZIndex="70" DataContext="{Binding LookupVM}"/>
    <views:OfflineSalesPanel Grid.RowSpan="3" Panel.ZIndex="75" DataContext="{Binding OfflineVM}"/>
    </Grid>
</Window>
