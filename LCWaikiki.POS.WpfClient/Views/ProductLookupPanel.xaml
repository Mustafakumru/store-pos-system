<UserControl x:Class="LCWaikiki.POS.WpfClient.Views.ProductLookupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
    <!-- DataContext: ProductLookupViewModel (host pencere atar) -->
    <UserControl.Resources>
        <Style x:Key="LkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#000000" Opacity="0.5"/>
        <Border Background="White" CornerRadius="10" Width="1040" MaxHeight="660" Padding="22"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Baslik -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="URUN BUL / FIYAT GOR" FontSize="18" FontWeight="Bold" Foreground="#1A237E"/>
                        <TextBlock Text="Urun kodu (orn. W6ER01Z8), barkod ya da urun adi girin. Renk, ardindan beden secin."
                                   FontSize="12" Foreground="#757575"/>
                    </StackPanel>
                    <Button Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" Foreground="#9E9E9E" FontSize="16" Padding="8,4"
                            Style="{StaticResource LkBtn}" Command="{Binding CloseCommand}"/>
                </Grid>

                <!-- Arama -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" FontSize="24" FontWeight="Bold" Padding="12,6"
                             FontFamily="Consolas" CharacterCasing="Upper"
                             BorderBrush="#007BFF" BorderThickness="2" VerticalContentAlignment="Center"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="QueryBox_KeyDown" GotFocus="QueryBox_GotFocus"/>
                    <Button Grid.Column="1" Content="ARA" Background="#007BFF" Margin="10,0,0,0" Width="120"
                            Style="{StaticResource LkBtn}" FontSize="16" Command="{Binding SearchCommand}"/>
                </Grid>

                <!-- Icerik -->
                <Grid Grid.Row="2">
                    <!-- Arama sonuclari (kod tam degilse) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LkBtn}" Background="#F5F7FA" Foreground="#212121"
                                            HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="14,10"
                                            Command="{Binding DataContext.PickSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid Width="940">
                                            <TextBlock FontSize="14">
                                                <Run Text="{Binding Code, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" Foreground="#1565C0"/>
                                                <Run Text="   "/>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#757575">
                                                <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding VariantCount, Mode=OneWay}"/>
                                                <Run Text=" varyant"/>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Urun: gorsel + bilgi | renkler + bedenler -->
                    <Grid Visibility="{Binding HasProduct, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <Border Height="260" Background="#F0F0F0" CornerRadius="6" ClipToBounds="True">
                                <Image Stretch="Uniform" Source="{Binding ProductImageUrl, TargetNullValue={x:Null}}"/>
                            </Border>
                            <TextBlock Text="{Binding Product.Code}" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                       Foreground="#1565C0" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="#212121"/>
                            <TextBlock Text="{Binding ClassificationText}" FontSize="11" Foreground="#616161"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PriceRangeText}" FontSize="16" FontWeight="Bold"
                                       Foreground="#2E7D32" Margin="0,6,0,0"/>
                            <TextBlock FontSize="11" Foreground="#757575">
                                <Run Text="Magaza stogu: "/>
                                <Run Text="{Binding Product.TotalStock, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="1. RENK" FontSize="12" FontWeight="Bold" Foreground="#757575" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Colors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8" MinWidth="120" Padding="14,10"
                                                Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LkBtn}">
                                                    <Setter Property="Background" Value="#ECEFF1"/>
                                                    <Setter Property="Foreground" Value="#212121"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#1565C0"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Color}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock FontSize="10" HorizontalAlignment="Center" Opacity="0.8">
                                                    <Run Text="stok "/><Run Text="{Binding TotalStock, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="2. BEDEN" FontSize="12" FontWeight="Bold" Foreground="#757575" Margin="0,10,0,6"/>
                            <TextBlock Text="Once renk secin." FontSize="12" Foreground="#9E9E9E" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedColor}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Sizes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8" Width="96" Height="70" Padding="4"
                                                Command="{Binding DataContext.SelectSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LkBtn}">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#212121"/>
                                                    <Setter Property="BorderBrush" Value="#B0BEC5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Size}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StockText}" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Secili varyant ozeti -->
                            <Border Background="#E8F5E9" CornerRadius="6" Padding="14,10" Margin="0,10,0,0"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#1B5E20">
                                            <Run Text="{Binding SelectedColor.Color, Mode=OneWay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding SelectedSize.Size, Mode=OneWay}"/>
                                            <Run Text="   Barkod: "/>
                                            <Run Text="{Binding SelectedSize.Dto.Barcode, Mode=OneWay}" FontFamily="Consolas"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#2E7D32">
                                            <Run Text="Magaza stogu: "/>
                                            <Run Text="{Binding SelectedSize.Stock, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"
                                               Foreground="#1B5E20"
                                               Text="{Binding SelectedSize.Dto.Price, Converter={StaticResource DecimalToCurrencyConverter}}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Alt: hata + butonlar -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,320,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Kapat" Background="#6C757D" Width="130" Margin="0,0,10,0"
                                Style="{StaticResource LkBtn}" Command="{Binding CloseCommand}"/>
                        <Button Content="SEPETE EKLE" Background="#28A745" Width="170"
                                Style="{StaticResource LkBtn}" FontSize="16" Command="{Binding AddToCartCommand}"
                                Visibility="{Binding CanAddToCart, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsEnabled="{Binding HasSelection}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
