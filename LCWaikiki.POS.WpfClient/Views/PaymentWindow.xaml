<Window x:Class="LCWaikiki.POS.WpfClient.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LCWaikiki.POS.WpfClient.Converters"
        Title="WPOS - Odeme"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F2F5">

    <Window.Resources>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- UST CUBUK -->
        <Border Grid.Row="0" Background="#1A237E">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF22" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Text="WPOS" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Odeme Ekrani" FontSize="14" Foreground="#90CAF9" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF15" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CashierName}" FontSize="12" Foreground="White"/>
                    </Border>
                    <Border Background="#FFFFFF15" CornerRadius="4" Padding="10,5">
                        <TextBlock x:Name="ClockText" FontSize="14" FontWeight="Bold"
                                   Foreground="White" FontFamily="Consolas"/>
                    </Border>
                    <Ellipse Width="9" Height="9" Fill="#4CAF50" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ANA ICERIK -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: OZET + ODEME LISTESI -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Belge Ozeti -->
                <Border Grid.Row="0" Background="#1A237E" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BELGE TOPLAMI" FontSize="11" Foreground="#90CAF9" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GrandTotal, Mode=OneWay,
                                           Converter={StaticResource DecimalToCurrencyConverter}}"
                                       FontSize="28" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0"
                                    Visibility="{Binding AppliedCouponCode,
                                        Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="KUPON INDIRIMI" FontSize="10" Foreground="#EF9A9A"/>
                            <TextBlock Text="{Binding CouponDiscount, Mode=OneWay,
                                           Converter={StaticResource DecimalToCurrencyConverter}}"
                                       FontSize="18" FontWeight="Bold" Foreground="#EF9A9A"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="KALAN TUTAR" FontSize="11" Foreground="#90CAF9" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RemainingAmount, Mode=OneWay,
                                           Converter={StaticResource DecimalToCurrencyConverter}}"
                                       FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Eklenen Odeme Kalemleri -->
                <Border Grid.Row="1" Background="White" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#F5F5F5" Padding="12,8">
                            <TextBlock Text="EKLENEN ODEMELER" FontSize="12" FontWeight="Bold" Foreground="#424242"/>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{Binding PaymentLines}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#212121" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Amount, Mode=OneWay,
                                                           Converter={StaticResource DecimalToCurrencyConverter}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="#1A237E" VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <Button Grid.Column="2" Content="X" Width="28" Height="28"
                                                    Focusable="False" Cursor="Hand"
                                                    Background="#FFEBEE" Foreground="#C62828"
                                                    BorderThickness="0" FontWeight="Bold"
                                                    Command="{Binding DataContext.RemovePaymentLineCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Musteriye Iade (Iade-Degisimde iade > yeni satis) -->
                <!-- Islem TAMAMLANMADAN yontem secilir; backend ayni islemde iade defterine yazar. -->
                <Border Grid.Row="1" Background="White" Margin="0,0,6,0"
                        Visibility="{Binding HasAmountOwed,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="20">
                        <TextBlock Text="MUSTERIYE IADE EDILECEK" FontSize="12" FontWeight="Bold"
                                   Foreground="#6D4C41"/>
                        <TextBlock Text="{Binding AmountOwedToCustomer, Mode=OneWay,
                                       Converter={StaticResource DecimalToCurrencyConverter}}"
                                   FontSize="34" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,16"/>

                        <TextBlock Text="Iade yontemi" FontSize="12" Foreground="#616161" Margin="0,0,0,6"/>
                        <UniformGrid Columns="3" Height="56">
                            <Button Content="NAKIT" Margin="0,0,6,0" Cursor="Hand" Focusable="False"
                                    FontSize="15" FontWeight="Bold"
                                    Command="{Binding SelectOwedRefundMethodCommand}" CommandParameter="Cash">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosButton}">
                                        <Setter Property="Background" Value="#ECEFF1"/>
                                        <Setter Property="Foreground" Value="#37474F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwedCash}" Value="True">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="KARTA" Margin="3,0" Cursor="Hand" Focusable="False"
                                    FontSize="15" FontWeight="Bold"
                                    ToolTip="Sadece kartla odenmis fislerde, fisteki kart tutarina kadar"
                                    Command="{Binding SelectOwedRefundMethodCommand}" CommandParameter="Card">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosButton}">
                                        <Setter Property="Background" Value="#ECEFF1"/>
                                        <Setter Property="Foreground" Value="#37474F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwedCard}" Value="True">
                                                <Setter Property="Background" Value="#1565C0"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="HEDIYE KARTI" Margin="6,0,0,0" Cursor="Hand" Focusable="False"
                                    FontSize="15" FontWeight="Bold"
                                    Command="{Binding SelectOwedRefundMethodCommand}" CommandParameter="GiftCard">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PosButton}">
                                        <Setter Property="Background" Value="#ECEFF1"/>
                                        <Setter Property="Foreground" Value="#37474F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwedGiftCard}" Value="True">
                                                <Setter Property="Background" Value="#AD1457"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsOwedGiftCard,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Hediye karti numarasi" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding OwedGiftCardInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18" Padding="8,6"/>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="#757575" TextWrapping="Wrap"
                                   Text="Yontemi secip onay (✓) tusuna basin. Iade bu islemle birlikte kaydedilir; nakit iade kasa sayiminda dusulur."/>
                    </StackPanel>
                </Border>

                <!-- Para Ustu / Hata -->
                <Border Grid.Row="2" Background="#E8F5E9" Padding="16,10"
                        Visibility="{Binding ChangeAmount, Mode=OneWay,
                            Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PARA USTU: " FontSize="16" FontWeight="Bold"
                                   Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangeAmount, Mode=OneWay,
                                       Converter={StaticResource DecimalToCurrencyConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#FFEBEE" Padding="12,8"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- ORTA: TUTAR GIRISI + NUMPAD -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tutar Girisi -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10,10">
                        <StackPanel>
                            <TextBlock Text="TUTAR GIRINIZ" FontSize="10"
                                       Foreground="#9E9E9E" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="AmountBox"
                                     FontSize="24" FontWeight="Bold"
                                     Foreground="#1A237E" Background="White"
                                     CaretBrush="#1A237E" BorderBrush="#1A237E"
                                     BorderThickness="0,0,0,2" Padding="6,4"
                                     TextAlignment="Right"
                                     Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- Kart Taksit Secimi -->
                    <Border Grid.Row="1" Padding="6,6" Background="White">
                        <StackPanel>
                            <TextBlock Text="KART TAKSIT" FontSize="10"
                   Foreground="#9E9E9E" FontWeight="Bold" Margin="0,0,0,4"/>
                            <UniformGrid Columns="3">
                                <Button Content="Pesin"
                    Command="{Binding SelectCardInstallmentCommand}"
                    CommandParameter="0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource InstBtn}">
                                            <Setter Property="Background" Value="#546E7A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCardInstallment, Mode=OneWay}" Value="0">
                                                    <Setter Property="Background" Value="#1A237E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="4 Taksit"
                    Command="{Binding SelectCardInstallmentCommand}"
                    CommandParameter="4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource InstBtn}">
                                            <Setter Property="Background" Value="#546E7A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCardInstallment, Mode=OneWay}" Value="4">
                                                    <Setter Property="Background" Value="#00695C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="8 Taksit"
                    Command="{Binding SelectCardInstallmentCommand}"
                    CommandParameter="8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource InstBtn}">
                                            <Setter Property="Background" Value="#546E7A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCardInstallment, Mode=OneWay}" Value="8">
                                                    <Setter Property="Background" Value="#1565C0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Numpad -->
                    <Border Grid.Row="2" Padding="6">
                        <UniformGrid Columns="4" Rows="4">
                            <Button Content="1" Tag="1" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="2" Tag="2" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="3" Tag="3" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="&#x2190;" Tag="backspace" Style="{StaticResource NumBtn}"
                                    Background="#EF5350" Foreground="White" Padding="0,12"/>
                            <Button Content="4" Tag="4" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="5" Tag="5" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="6" Tag="6" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="X" Tag="clear" Style="{StaticResource NumBtn}"
                                    Background="#E53935" Foreground="White" Padding="0,12"/>
                            <Button Content="7" Tag="7" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="8" Tag="8" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="9" Tag="9" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="&#x2713;" Tag="confirm" Style="{StaticResource NumBtn}"
                                    Background="#43A047" Foreground="White" FontSize="20" Padding="0,12"/>
                            <Button Content="," Tag="." Style="{StaticResource NumBtn}"
                                    Background="#CFD8DC" Foreground="#263238" Padding="0,12"/>
                            <Button Content="0" Tag="0" Style="{StaticResource NumBtn}"
                                    Background="#ECEFF1" Foreground="#263238" Padding="0,12"/>
                            <Button Content="00" Tag="00" Style="{StaticResource NumBtn}"
                                    Background="#CFD8DC" Foreground="#263238" FontSize="15" Padding="0,12"/>
                            <Button Content="T" Tag="tumu" Style="{StaticResource NumBtn}"
                                    Background="#FB8C00" Foreground="White" Padding="0,12"
                                    ToolTip="Kalan tutarin tamami"/>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- SAG: ODEME YONTEMLERI -->
            <Border Grid.Column="2" Background="#F5F5F5">
                <StackPanel Margin="6">
                    <TextBlock Text="ODEME YONTEMI" FontSize="11"
                               Foreground="#9E9E9E" FontWeight="Bold"
                               Margin="0,6,0,8" HorizontalAlignment="Center"/>
                    <Button Content="Nakit" Style="{StaticResource PayBtn}"
                            Background="#2E7D32" Margin="0,0,0,6"
                            Command="{Binding AddCashCommand}"/>
                    <Button Content="Kredi Karti" Style="{StaticResource PayBtn}"
                            Background="#1565C0" Margin="0,0,0,6"
                            Command="{Binding AddCardCommand}"/>
                    <Button Content="Hediye Karti" Style="{StaticResource PayBtn}"
                            Background="#6A1B9A" Margin="0,0,0,6"
                            Command="{Binding OpenGiftCardPanelCommand}"/>
                    <Button Style="{StaticResource PayBtn}"
                            Background="#00695C" Margin="0,0,0,6"
                            Command="{Binding AddUsdCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="USD" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kur: 32,50" FontSize="10"
                                       Foreground="#B2DFDB" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PayBtn}"
                            Background="#01579B" Margin="0,0,0,6"
                            Command="{Binding AddEurCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="EUR" FontSize="14" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kur: 35,20" FontSize="10"
                                       Foreground="#B3E5FC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,8"/>
                    <Button Style="{StaticResource PayBtn}"
                            Background="#E65100" Margin="0,0,0,6"
                            Command="{Binding OpenCouponPanelCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Kupon Gir" FontSize="13" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock FontSize="10" Foreground="#FFCCBC"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding AppliedCouponCode,
                                           Converter={StaticResource StringToVisibilityConverter}}">
                                <Run Text="Uygulandi: "/>
                                <Run Text="{Binding AppliedCouponCode, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Content="Kuponu Kaldir" Style="{StaticResource PayBtn}"
                            Background="#B71C1C" Margin="0,0,0,6"
                            Command="{Binding RemoveCouponCommand}"
                            Visibility="{Binding AppliedCouponCode,
                                Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ALT CUBUK -->
        <Border Grid.Row="2" Background="#263238">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Geri Don"
                        Background="#37474F" Foreground="White"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Focusable="False" Cursor="Hand"
                        Margin="0,8" Command="{Binding GoBackCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Content="SATISI TAMAMLA"
                        Background="#00897B" Foreground="White"
                        FontSize="15" FontWeight="Bold"
                        BorderThickness="0" Focusable="False" Cursor="Hand"
                        Margin="0,8" Command="{Binding CompleteSaleCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="0,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- OVERLAY: KUPON GIRISI -->
        <Grid Grid.Row="1" Panel.ZIndex="20"
              Visibility="{Binding IsCouponPanelOpen,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#55000000"/>
            <Border Background="#1E272E" CornerRadius="10"
                    Width="380" Height="240"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="KUPON KODU GIR" FontSize="15" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Kupon kodunuzu girerek indirim uygulayabilirsiniz."
                               FontSize="11" Foreground="#90CAF9"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBox x:Name="CouponBox"
                             FontSize="20" FontWeight="Bold"
                             Foreground="White" Background="#2D3748"
                             BorderBrush="#3D5AFE" BorderThickness="0,0,0,2"
                             CaretBrush="White" Padding="10,8"
                             HorizontalContentAlignment="Center" Margin="0,0,0,16"
                             Text="{Binding CouponInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Iptal" Focusable="False"
                                Background="#37474F" Foreground="White"
                                BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                                Padding="0,10" Margin="0,0,4,0"
                                Command="{Binding CancelCouponCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="Uygula" Focusable="False"
                                Background="#E65100" Foreground="White"
                                BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                                Padding="0,10" Margin="4,0,0,0"
                                Command="{Binding ApplyCouponCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY: HEDIYE KARTI -->
        <Grid Grid.Row="1" Panel.ZIndex="20"
              Visibility="{Binding IsGiftCardPanelOpen,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#55000000"/>
            <Border Background="#1E272E" CornerRadius="10"
                    Width="400" Height="280"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="HEDIYE KARTI" FontSize="15" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Kart numarasini giriniz"
                               FontSize="11" Foreground="#90CAF9"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox x:Name="GiftCardBox"
                             FontSize="18" FontWeight="Bold"
                             Foreground="White" Background="#2D3748"
                             BorderBrush="#3D5AFE" BorderThickness="0,0,0,2"
                             CaretBrush="White" Padding="10,8"
                             HorizontalContentAlignment="Center" Margin="0,0,0,8"
                             Text="{Binding GiftCardInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <Border Background="#1B5E20" CornerRadius="4" Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding IsGiftCardValid,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White">
                            <Run Text="Bakiye: "/>
                            <Run Text="{Binding GiftCardBalance, Mode=OneWay,
                                Converter={StaticResource DecimalToCurrencyConverter}}"/>
                        </TextBlock>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Iptal" Focusable="False"
                                Background="#37474F" Foreground="White"
                                BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                Padding="0,10" Margin="0,0,3,0"
                                Command="{Binding CancelGiftCardCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="Sorgula" Focusable="False"
                                Background="#1565C0" Foreground="White"
                                BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                Padding="0,10" Margin="3,0"
                                Command="{Binding QueryGiftCardCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="Ekle" Focusable="False"
                                Background="#2E7D32" Foreground="White"
                                BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                Padding="0,10" Margin="3,0,0,0"
                                Command="{Binding AddGiftCardCommand}"
                                IsEnabled="{Binding IsGiftCardValid}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>